#!/bin/bash

music_dir=/home/ananasik/Music
playlist="$music_dir/playlist/ES"
playing_order=/usr/local/etc/play-music/order-everlasting-summer.cfg

songs="$(cat $playing_order)"
paths_to_songs=""
for song in $songs; do
  path_to_song="$(find "$music_dir" -name "$song" 2>/dev/null)"
  if [ $? -ne 0 ]; then
    echo "Song not found: $song"
    exit 1
  fi
  paths_to_songs="$paths_to_songs $path_to_song"
done

mpv --fs --force-window --no-video $paths_to_songs
