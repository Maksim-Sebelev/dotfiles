#!/bin/bash

set -euo pipefail

CONFIGS=(
  "shojiwm-rain"
  "hypr-winter"
)

function help
{
  echo "Usage: $(basename "$0") <config>"
  echo
  echo "Available configs:"
  for cfg in "${CONFIGS[@]}"; do
    echo "  - $cfg"
  done
  echo
  echo "  - help, h, -h, --help    Show this message"
}

if [ $# -ne 1 ]; then
  help
  exit 1
fi

ARG="$1"

case "$ARG" in
  help|h|-h|--help)
    help
    exit 0
    ;;

  shojiwm-rain)
    echo "[config-switch] switching to: shojiwm-rain"
    cd ~/dotfiles
    stow -R shojiwm-rain
    ;;

  hypr-winter)
    echo "[config-switch] switching to: hypr-winter"
    cd ~/dotfiles
    stow -R hypr-winter
    ;;

  *)
    echo "[config-switch] unknown config: $ARG"
    echo
    help
    exit 1
    ;;
esac

echo "[apply-setup] done. don't forget about target-depended reloading!"
