#!/bin/bash

set -euo pipefail

CONFIGS=(
  "shojiwm-rain"
  "hypr-winter"
)

dotfiles_dir="$(dirname $0)"
echo "$dotfiles_dir"

function help
{
  echo "Usage: $(basename "$0") <config>"
  echo
  echo "Available configs:"
  for cfg in "${CONFIGS[@]}"; do
    echo "  - $cfg"
  done
  echo
  echo "  - help, h, -h, --help    Show this message"
}

function shojiwm_rain_action
{
  echo "[config-switch] switching to: hypr-winter"
  cd "$dotfiles_dir"
  stow -R shojiwm-rain
  echo "[reloading] don't forget about reloading (Super+Shift+R)"
}

function hypr_winter_action
{
  echo "[config-switch] switching to: hypr-winter"
  echo "Not implemented now"
  # cd "$dotfiles_dir"
  # stow -R hypr-winter
  echo "[reloading] don't forget about reloading"
}

if [ $# -ne 1 ]; then
  help
  exit 1
fi

ARG="$1"

case "$ARG" in
  help|h|-h|--help)
    help
    exit 0
    ;;

  shojiwm-rain)
    shojiwm_rain_action
    ;;

  hypr-winter)
    hypr_winter_action
    ;;

  *)
    echo "[config-switch] unknown config: $ARG"
    echo
    help
    exit 1
    ;;
esac

echo "[apply-setup] done"
